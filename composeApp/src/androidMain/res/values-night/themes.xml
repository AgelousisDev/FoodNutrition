<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.App.Splash" parent="Theme.SplashScreen">
        <!-- The theme the app switches to after the splash finishes -->
        <item name="postSplashScreenTheme">@android:style/Theme.Material.Light.NoActionBar</item>

        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">1000</item> <!-- Matches AVD duration -->

        <!-- Background should follow dark/light mode -->
        <item name="windowSplashScreenBackground">?android:attr/colorBackground</item>
    </style>
</resources>